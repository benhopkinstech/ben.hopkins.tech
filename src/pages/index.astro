---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SocialLinks from '../components/SocialLinks.astro';
import profileImage from '../assets/profile.png';
import { profile, isEmail } from '../data/profile';

// Structured data that tells search engines who this page is about
// and that the linked profiles belong to the same person.
const portrait = await getImage({ src: profileImage, width: 352, height: 352 });
const email = profile.socials.find(isEmail)?.href.replace('mailto:', '');
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: Astro.site?.href,
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    url: Astro.site?.href,
    image: new URL(portrait.src, Astro.site).href,
    jobTitle: profile.role,
    worksFor: { '@type': 'Organization', name: profile.company },
    email,
    sameAs: profile.socials.filter((s) => !isEmail(s)).map((s) => s.href),
  },
};
---

<Layout>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <Header />

  <main class="mx-auto max-w-3xl px-6 pb-16">
    <!-- Hero -->
    <section class="flex flex-col-reverse items-start gap-8 pt-8 sm:flex-row sm:items-center sm:justify-between sm:pt-14">
      <div class="max-w-md">
        <p class="font-mono text-sm text-accent">hello, world</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
          I'm {profile.name}.
        </h1>
        <p class="mt-2 text-lg font-medium text-stone-600">
          {profile.role} at {profile.company}
        </p>
        <p class="mt-5 leading-relaxed text-stone-600">
          {profile.intro}
        </p>
      </div>

      <Image
        src={profileImage}
        alt={`Illustrated portrait of ${profile.name}`}
        width={352}
        height={352}
        priority
        class="size-36 shrink-0 rounded-full object-cover ring-1 ring-stone-300 ring-offset-4 ring-offset-paper sm:size-44"
      />
    </section>

    <!-- Elsewhere -->
    <section class="mt-12 sm:mt-14" aria-labelledby="elsewhere-heading">
      <h2 id="elsewhere-heading" class="flex items-center gap-3 font-mono text-sm text-stone-500">
        <span><span class="text-accent" aria-hidden="true">#</span> find me elsewhere</span>
        <span class="h-px flex-1 bg-stone-200" aria-hidden="true"></span>
      </h2>
      <div class="mt-5">
        <SocialLinks />
      </div>
    </section>
  </main>

</Layout>
