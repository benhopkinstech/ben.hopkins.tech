---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { profile } from '../data/profile';
---

<Layout title={`Page not found · ${profile.name}`} noindex>
  <Header />
  <main class="mx-auto max-w-3xl px-6 pb-16">
    <section class="pt-8 sm:pt-14">
      <p class="font-mono text-sm text-accent">404</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">This page doesn't exist.</h1>
      <p class="mt-5 max-w-md leading-relaxed text-stone-600">
        The link may be old or mistyped. You can head <a
          href="/"
          class="font-medium text-ink underline decoration-accent/40 underline-offset-4 hover:text-accent hover:decoration-accent"
          >back home</a
        >, or find me in one of these places instead.
      </p>
    </section>

    <section class="mt-12" aria-label="Where to find me">
      <SocialLinks />
    </section>
  </main>
</Layout>
